# DERMASATHIAI Environment Configuration
PROJECT_NAME="DERMASATHIAI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security (Generate random secure string in production: openssl rand -hex 32)
SECRET_KEY="dermasathi-secure-development-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For production PostgreSQL: postgresql://dermasathi_user:password@localhost:5432/dermasathidb
# Local development fallback: sqlite:///./dermasathi.db
DATABASE_URL="sqlite:///./dermasathi.db"

# Google Gemini API Key for Medical Report & Document Analysis
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# ML Model Integration (Trained ResNet50 Keras 3 Model)
DERMASATHI_MODEL_PATH="backend/model_store/model.keras"
DERMASATHI_CLASS_MAPPING_PATH="backend/model_store/class_mapping.json"
DERMASATHI_POLICY_PATH="backend/model_store/skin_ai_policy.json"

# Clinical Safety Thresholds
QUALITY_BLUR_THRESHOLD=60.0
CONFIDENCE_ABSTENTION_THRESHOLD=0.70
OOD_UNCERTAINTY_THRESHOLD=0.65

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
